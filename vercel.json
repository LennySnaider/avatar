{
    "crons": [
        {
            "path": "/api/cron/social-reconcile",
            "schedule": "*/15 * * * *"
        },
        {
            "path": "/api/cron/agent-inbox-poll",
            "schedule": "*/5 * * * *"
        },
        {
            "path": "/api/cron/billing-holds-sweep",
            "schedule": "17 * * * *"
        },
        {
            "path": "/api/cron/module-fees",
            "schedule": "23 3 * * *"
        },
        {
            "path": "/api/cron/agent-autopilot-flush",
            "schedule": "* * * * *"
        },
        {
            "path": "/api/cron/social-comments-poll",
            "schedule": "*/15 * * * *"
        },
        {
            "path": "/api/cron/earnings-sync",
            "schedule": "41 * * * *"
        },
        {
            "path": "/api/cron/ai-marks-sweep",
            "schedule": "* * * * *"
        }
    ],
    "services": {
        "web": {
            "root": ".",
            "framework": "nextjs",
            "bindings": [
                {
                    "type": "service",
                    "service": "cleaner",
                    "format": "url",
                    "env": "AI_MARKS_CLEANER_URL"
                }
            ]
        },
        "cleaner": {
            "root": "services/cleaner",
            "runtime": "container",
            "entrypoint": "Dockerfile.vercel"
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": {
                "service": "web"
            }
        }
    ]
}
